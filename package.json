{
  "name": "pokedex-nuxt",
  "version": "2.0.0",
  "description": "Pokedex built with Vue Nuxt",
  "author": "Ans de Nijs (Little mousey)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "generate:pages": "NUXT_SPA=true nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.1",
    "nes.css": "^2.3.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
